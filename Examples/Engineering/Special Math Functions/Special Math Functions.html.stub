 <p>
  Recurrence test:
  <span class="eq">
   <var>n</var>
   = 1
  </span>
  ,
  <span class="eq">
   <var>x</var>
   = 100
  </span>
 </p>
 <p>
  <span class="eq">
   <var>Y</var>
   (
   <var>n</var>
   − 1;
   <var>x</var>
   )  +
   <var>Y</var>
   (
   <var>n</var>
   + 1;
   <var>x</var>
   )  −
   <span class="dvc">
    2 ·
    <var>n</var>
    <span class="dvl">
    </span>
    <var>x</var>
   </span>
   ·
   <var>Y</var>
   (
   <var>n</var>
   ;
   <var>x</var>
   )  =
   <var>Y</var>
   ( 1 − 1; 100 )  +
   <var>Y</var>
   ( 1 + 1; 100 )  −
   <span class="dvc">
    2 · 1
    <span class="dvl">
    </span>
    100
   </span>
   ·
   <var>Y</var>
   ( 1; 100 )  = -1.11×10
   <sup>-16</sup>
  </span>
 </p>

     <var>x</var>
     &lt;
     <var>e</var>
     :
     <span class="cond">$Root</span>
     {
     <var>ξ</var>
     ·
     <b>exp</b>
     (
     <var>ξ</var>
     )  =
     <var>x</var>
     ;
     <var>ξ</var>
     ∈ [-1; 1]}
     <br/>
     else:
     <span class="cond">$Root</span>
     {
     <var>ξ</var>
     ·
     <b>exp</b>
     (
     <var>ξ</var>
     )  =
     <var>x</var>
     ;
     <var>ξ</var>
     ∈ [
     <var>W</var>
     <sub>btm</sub>
     (
     <var>x</var>
     ) ;
     <var>W</var>
     <sub>top</sub>
     (
     <var>x</var>
     ) ]}
    </span>
   </span>

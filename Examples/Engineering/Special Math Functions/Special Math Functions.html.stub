 <p>
  Checks:
  <span class="eq">
   <var>Γ</var>
   ( 0 )  =
   <span class="err">+∞</span>
  </span>
  ,
  <span class="eq">
   <var>Γ</var>
   ( 4 )  = 6
  </span>
  = 3!,
  <span class="eq">
   <var>Γ</var>
   ( 5 )  = 24
  </span>
  = 4!
 </p>
 <p>
  <span class="eq">
   <var>x</var>
   = 50
  </span>
  ,
  <span class="eq">
   <var>x</var>
   ! = 50! = 3.04×10
   <sup>64</sup>
  </span>
  ,
  <span class="eq">
   <span class="dvc">
    <var>Γ</var>
    (
    <var>x</var>
    + 1 )  −
    <var>x</var>
    !
    <span class="dvl">
    </span>
    <var>x</var>
    !
   </span>
   =
   <span class="dvc">
    <var>Γ</var>
    ( 50 + 1 )  − 50!
    <span class="dvl">
    </span>
    50!
   </span>
   = -3.84×10
   <sup>-16</sup>
  </span>
 </p>
 <p>
  <strong>Digamma function</strong>
  -
  <span class="eq">
   <var>ψ</var>
   (
   <var>x</var>
   )  =
   <span class="dvr">
    <small>1</small>
    <span class="nary">
     <em>∫</em>
    </span>
    <small>0</small>
   </span>
   <span class="dvc">
    1 −
    <var>t</var>
    <sup>
     <var>x</var>
     − 1
    </sup>
    <span class="dvl">
    </span>
    1 −
    <var>t</var>
   </span>
   d
   <var>t</var>
   −
   <var>γ</var>
  </span>
 </p>
 <br/>
 <strong>Polygamma function</strong>
 -
 <span class="eq">
  <var>ψ</var>
  <sub>m</sub>
  (
  <var>m</var>
  ;
  <var>x</var>
  )  =  ( -1 )
  <sup>
   <var>m</var>
   + 1
  </sup>
  ·
  <span class="dvr">
   <small>1</small>
   <span class="nary">
    <em>∫</em>
   </span>
   <small>
    <var>ε</var>
   </small>
  </span>
  <span class="dvc">
   ( -
   <b>ln</b>
   (
   <var>t</var>
   )  )
   <sup>
    <var>m</var>
   </sup>
   ·
   <var>t</var>
   <sup>
    <var>x</var>
    − 1
   </sup>
   <span class="dvl">
   </span>
   1 −
   <var>t</var>
  </span>
  d
  <var>t</var>
 </span>
 , where
 <span class="eq">
  <var>ε</var>
  = 10
  <sup>-300</sup>
 </span>

 <p>Checks:</p>
 <p>
  <span class="eq">
   <var>ψ</var>
   <sub>m</sub>
   ( 1; 1 )  −
   <span class="dvc">
    <var>π</var>
    <sup>2</sup>
    <span class="dvl">
    </span>
    6
   </span>
   =
   <var>ψ</var>
   <sub>m</sub>
   ( 1; 1 )  −
   <span class="dvc">
    3.14
    <sup>2</sup>
    <span class="dvl">
    </span>
    6
   </span>
   = 2.22×10
   <sup>-16</sup>
  </span>
 </p>
 <p>
  <span class="eq">
   <var>ψ</var>
   <sub>2,1</sub>
   = -2.4
  </span>
  -2 times Apéry constant
 </p>
 <p>
  <span class="eq">
   <var>ψ</var>
   <sub>m</sub>
   ( 2; 1 )  −
   <var>ψ</var>
   <sub>2,1</sub>
   =
   <var>ψ</var>
   <sub>m</sub>
   ( 2; 1 )  −  ( -2.4 )  = -8.44×10
   <sup>-15</sup>
  </span>
 </p>
 <p>
  <span class="eq">
   <var>ψ</var>
   <sub>m</sub>
   ( 3; 1 )  −
   <span class="dvc">
    <var>π</var>
    <sup>4</sup>
    <span class="dvl">
    </span>
    15
   </span>
   =
   <var>ψ</var>
   <sub>m</sub>
   ( 3; 1 )  −
   <span class="dvc">
    3.14
    <sup>4</sup>
    <span class="dvl">
    </span>
    15
   </span>
   = 2.66×10
   <sup>-15</sup>
  </span>
 </p>

 <p>
  Checks:
  <span class="eq">
   <var>B</var>
   ( 1; 1; 1 )  = 1
  </span>
  ,
  <span class="eq">
   <var>B</var>
   ( 1; 2; 3 )  · 12 = 1
  </span>
  ,
  <span class="eq">
   <span class="dvc">
    -
    <var>B</var>
    ( 2; 2; 2 )  · 3
    <span class="dvl">
    </span>
    2
   </span>
   = 1
  </span>
 </p>
 <p>
  <strong>Riemann Zeta function</strong>
  -
  <span class="eq">
   <var>ζ</var>
   (
   <var>x</var>
   )  =
   <span class="dvc">
    1
    <span class="dvl">
    </span>
    <var>Γ</var>
    (
    <var>x</var>
    )
   </span>
   ·
   <span class="dvr">
    <small>1</small>
    <span class="nary">
     <em>∫</em>
    </span>
    <small>0</small>
   </span>
   <span class="dvc">
    ( -
    <b>ln</b>
    (
    <var>t</var>
    )  )
    <sup>
     <var>x</var>
     − 1
    </sup>
    <span class="dvl">
    </span>
    1 −
    <var>t</var>
   </span>
   d
   <var>t</var>
  </span>
 </p>

 <strong>Hyperbolic sine and cosine integrals</strong>
 :
 <p>
  <span class="eq">
   <var>Chi</var>
   <sub>e</sub>
   (
   <var>x</var>
   )  =
   <span class="dvcs">
    <span class="c3">{</span>
    <span class="dvs">
     if
     <var>x</var>
     ≡ 0: -1
     <em>/</em>
     0
     <br/>
     else:
     <var>γ</var>
     +
     <b>ln</b>
     (
     <var>x</var>
     )  +
     <span class="dvr">
      <small>
       <var>x</var>
      </small>
      <span class="nary">
       <em>∫</em>
      </span>
      <small>0</small>
     </span>
     <span class="dvc">
      <b>cosh</b>
      (
      <var>t</var>
      )  − 1
      <span class="dvl">
      </span>
      <var>t</var>
     </span>
     d
     <var>t</var>
    </span>
   </span>
  </span>
  ,
  <span class="eq">
   <var>Shi</var>
   <sub>e</sub>
   (
   <var>x</var>
   )  =
   <span class="dvcs">
    <span class="c3">{</span>
    <span class="dvs">
     if
     <var>x</var>
     ≡ 0: 0
     <br/>
     else:
     <span class="dvr">
      <small>
       <var>x</var>
      </small>
      <span class="nary">
       <em>∫</em>
      </span>
      <small>0</small>
     </span>
     <span class="dvc">
      <b>sinh</b>
      (
      <var>t</var>
      )
      <span class="dvl">
      </span>
      <var>t</var>
     </span>
     d
     <var>t</var>
    </span>
   </span>
  </span>
 </p>

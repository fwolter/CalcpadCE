 <h5>Integral functions</h5>
 <p>
  <strong>Fresnel integrals</strong>
  :
  <span class="eq">
   <var>C</var>
   (
   <var>x</var>
   )  =
   <span class="dvr">
    <small>
     <var>x</var>
    </small>
    <span class="nary">
     <em>∫</em>
    </span>
    <small>0</small>
   </span>
   <b>cos</b>
   (
   <var>t</var>
   <sup>2</sup>
   )  d
   <var>t</var>
  </span>
  ,
  <span class="eq">
   <var>S</var>
   (
   <var>x</var>
   )  =
   <span class="dvr">
    <small>
     <var>x</var>
    </small>
    <span class="nary">
     <em>∫</em>
    </span>
    <small>0</small>
   </span>
   <b>sin</b>
   (
   <var>t</var>
   <sup>2</sup>
   )  d
   <var>t</var>
  </span>
 </p>

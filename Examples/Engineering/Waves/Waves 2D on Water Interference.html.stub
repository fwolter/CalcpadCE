<div class="calcpad-output">
 <!-- Static snapshot of two coherent point sources on a water surface: the field $\Psi(x,\, y)$ is plotted as a heat-map showing the canonical hyperbolic interference fringes. -->
 <p>Assoc. prof. Tadeusz Szumiata, PhD, Radom University, Poland</p>
 <p>
 </p>
 <p>Interferencja fal na wodzie</p>
 <p>
  <span class="eq">
   <var>λ</var>
   = 0.2
   <i>m</i>
  </span>
 </p>
 <p>
  <span class="eq">
   <var>k</var>
   =
   <span class="dvc">
    2 ·
    <var>π</var>
    <span class="dvl">
    </span>
    <var>λ</var>
   </span>
   =
   <span class="dvc">
    2 · 3.14
    <span class="dvl">
    </span>
    0.2
    <i>m</i>
   </span>
   = 31.42
   <i>m</i>
   <sup class="unit">-1</sup>
  </span>
 </p>
 <p>
  <span class="eq">
   <var>r</var>
   (
   <var>x</var>
   ;
   <var>y</var>
   )  =
   <span class="o0">
    <span class="r">√</span>
    <var>x</var>
    <sup>2</sup>
    +
    <var>y</var>
    <sup>2</sup>
   </span>
  </span>
 </p>
 <p>
  <span class="eq">
   <var>a</var>
   = 0.6
   <i>m</i>
  </span>
 </p>
 <p>
  <span class="eq">
   <var>v</var>
   = 1
   <span class="dvc">
    <i>m</i>
    <span class="dvl">
    </span>
    <i>s</i>
   </span>
  </span>
 </p>
 <p>
  <span class="eq">
   <var>T</var>
   =
   <span class="dvc">
    <var>λ</var>
    <span class="dvl">
    </span>
    <var>v</var>
   </span>
   =
   <span class="dvc">
    0.2
    <i>m</i>
    <span class="dvl">
    </span>
    1
    <i>m</i>
    <i class="unit">∕</i>
    <i>s</i>
   </span>
   = 0.2
   <i>s</i>
  </span>
 </p>
 <p>
  <span class="eq">
   <var>f</var>
   =
   <span class="dvc">
    1
    <span class="dvl">
    </span>
    <var>T</var>
   </span>
   = 5
   <i>Hz</i>
  </span>
 </p>
 <p>
  <span class="eq">
   <var>ω</var>
   =
   <span class="dvc">
    2 ·
    <var>π</var>
    <span class="dvl">
    </span>
    <var>T</var>
   </span>
   =
   <span class="dvc">
    2 · 3.14
    <span class="dvl">
    </span>
    0.2
    <i>s</i>
   </span>
   = 31.42
   <i>s</i>
   <sup class="unit">-1</sup>
  </span>
 </p>
 <p>
  <span class="eq">
   <var>Ψ</var>
   <sub>0</sub>
   = 0.5
   <i>m</i>
  </span>
 </p>
 <p>
  <span class="eq">
   <var>t</var>
   = 0
   <i>s</i>
  </span>
 </p>
 <p>
  <span class="eq">
   <var>Δt</var>
   =
   <span class="dvc">
    0 ·
    <var>T</var>
    <span class="dvl">
    </span>
    4
   </span>
   = 0
   <i>s</i>
  </span>
 </p>
 <p>
  <span class="eq">
   <var>Ψ</var>
   <sub>2D_1</sub>
   (
   <var>x</var>
   ;
   <var>y</var>
   ;
   <var>t</var>
   )  =
   <var>Ψ</var>
   <sub>0</sub>
   ·
   <b>sin</b>
   <span class="b1">(</span>
   <var>k</var>
   ·
   <var>r</var>
   <span class="b1">(</span>
   <var>x</var>
   −
   <span class="dvc">
    <var>a</var>
    <span class="dvl">
    </span>
    2
   </span>
   ;
   <var>y</var>
   <span class="b1">)</span>
   −
   <var>ω</var>
   ·
   <var>t</var>
   <span class="b1">)</span>
  </span>
 </p>
 <p>
  <span class="eq">
   <var>Ψ</var>
   <sub>2D_2</sub>
   (
   <var>x</var>
   ;
   <var>y</var>
   ;
   <var>t</var>
   )  =
   <var>Ψ</var>
   <sub>0</sub>
   ·
   <b>sin</b>
   <span class="b1">(</span>
   <var>k</var>
   ·
   <var>r</var>
   <span class="b1">(</span>
   <var>x</var>
   +
   <span class="dvc">
    <var>a</var>
    <span class="dvl">
    </span>
    2
   </span>
   ;
   <var>y</var>
   <span class="b1">)</span>
   −
   <var>ω</var>
   ·  (
   <var>t</var>
   +
   <var>Δt</var>
   )
   <span class="b1">)</span>
  </span>
 </p>
 <p>
  <span class="eq">
   <var>Ψ</var>
   <sub>2D</sub>
   (
   <var>x</var>
   ;
   <var>y</var>
   ;
   <var>t</var>
   )  =
   <var>Ψ</var>
   <sub>2D_1</sub>
   (
   <var>x</var>
   ;
   <var>y</var>
   ;
   <var>t</var>
   )  +
   <var>Ψ</var>
   <sub>2D_2</sub>
   (
   <var>x</var>
   ;
   <var>y</var>
   ;
   <var>t</var>
   )
  </span>
 </p>
 <p>

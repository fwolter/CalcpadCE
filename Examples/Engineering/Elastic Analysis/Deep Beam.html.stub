 <h3>Calculation of stresses</h3>
 <p>
  <span class="eq">
   <var>σ</var>
   <sub>x</sub>
   (
   <var>x</var>
   ;
   <var>y</var>
   )  =
   <span class="dvr">
    <small>
     <var>N</var>
    </small>
    <span class="nary">∑</span>
    <small>
     <var>n</var>
     = 1
    </small>
   </span>
   <var>Y</var>
   <sub>2</sub>
   (
   <var>n</var>
   ;
   <var>y</var>
   )  ·
   <b>sin</b>
   (
   <var>α</var>
   (
   <var>n</var>
   )  ·
   <var>x</var>
   )
  </span>
 </p>

 <p>
  <b>Constitutive matrix</b>
  (stress - strain relationship)
 </p>
 <p>
  <span class="eq">
   <var>D</var>
   <sub>1,1</sub>
   =
   <span class="dvc">
    <var>E</var>
    ·
    <var>t</var>
    <sup>3</sup>
    <span class="dvl">
    </span>
    12 ·  ( 1 −
    <var>ν</var>
    <sup>2</sup>
    )
   </span>
   =
   <span class="dvc">
    35000 · 0.2
    <sup>3</sup>
    <span class="dvl">
    </span>
    12 ·  ( 1 − 0.2
    <sup>2</sup>
    )
   </span>
   = 24.31
  </span>
  kNm
 </p>
 <p>
  <span class="eq">
   <b>
    <var>D</var>
   </b>
   =
   <var>D</var>
   <sub>1,1</sub>
   ·
   <b>hp</b>
   <span class="b1">(</span>
   <span class="b1">[</span>
   1;
   <var>ν</var>
   ; 0
   <span class="b0">|</span>
   <var>ν</var>
   ; 1; 0
   <span class="b0">|</span>
   0; 0;
   <span class="dvc">
    1 −
    <var>ν</var>
    <span class="dvl">
    </span>
    2
   </span>
   <span class="b1">]</span>
   <span class="b1">)</span>
   = 24.31 ·
   <b>hp</b>
   <span class="b1">(</span>
   <span class="b1">[</span>
   1; 0.2; 0
   <span class="b0">|</span>
   0.2; 1; 0
   <span class="b0">|</span>
   0; 0;
   <span class="dvc">
    1 − 0.2
    <span class="dvl">
    </span>
    2
   </span>
   <span class="b1">]</span>
   <span class="b1">)</span>
   =
   <span class="matrix">
    <span class="tr">
     <span class="td">
     </span>
     <span class="td">24.31</span>
     <span class="td">4.86</span>
     <span class="td">0</span>
     <span class="td">
     </span>
    </span>
    <span class="tr">
     <span class="td">
     </span>
     <span class="td">4.86</span>
     <span class="td">24.31</span>
     <span class="td">0</span>
     <span class="td">
     </span>
    </span>
    <span class="tr">
     <span class="td">
     </span>
     <span class="td">0</span>
     <span class="td">0</span>
     <span class="td">9.72</span>
     <span class="td">
     </span>
    </span>
   </span>
  </span>
  kNm
 </p>
 <div class="fold">
